# Скопіюйте у файл .env (він у .gitignore) і заповніть. Реальні змінні середовища мають пріоритет.

# --- Розробка (за замовчуванням, якщо змінних немає) ---
DJANGO_DEBUG=1

# --- Продакшен: розкоментуйте і заповніть ---
# DJANGO_DEBUG=0
# Згенеруйте: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# DJANGO_BEHIND_PROXY=1          # якщо HTTPS завершує nginx/балансувальник
# NUM_PROXIES=1                  # скільки проксі перед Django (для визначення IP клієнта)
# ADMIN_URL=my-secret-admin/
# REDIS_URL=redis://localhost:6379/1   # спільний кеш для rate limiting при кількох воркерах
